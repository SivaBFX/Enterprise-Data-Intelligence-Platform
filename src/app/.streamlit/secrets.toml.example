# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your Databricks workspace credentials
# to run the application locally on localhost:8501.

# Your Databricks workspace URL (without trailing slash)
DATABRICKS_HOST = "https://your-databricks-workspace.cloud.databricks.com"

# Personal Access Token generated from Databricks User Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN = "dapi_your_personal_access_token_here"

# SQL Warehouse ID from Compute -> SQL Warehouses (Overview tab -> HTTP Path / ID)
DATABRICKS_WAREHOUSE_ID = "your_warehouse_id_here"

# (Optional) Genie Space ID for natural language AI chat
GENIE_SPACE_ID = "your_genie_space_id_here"

# (Optional) Table overrides if different from workspace.gold defaults
# PORTFOLIO_KPIS_TABLE = "workspace.gold.gold_portfolio_kpis"
# MARKET_MONTHLY_TABLE = "workspace.gold.gold_market_monthly"
# PROPERTY_PERFORMANCE_TABLE = "workspace.gold.gold_property_performance"
# MAINTENANCE_TABLE = "workspace.gold.gold_maintenance_summary"
# CAPEX_TABLE = "workspace.gold.gold_capex_summary"

